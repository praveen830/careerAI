# ===================================================================
# CareerAI Backend Environment Template (.env.example)
# Copy this file to .env and configure your local settings
# ===================================================================

# Server Settings
SERVER_PORT=8080
PORT=8080

# MySQL Database Credentials
DB_HOST=localhost
DB_PORT=3306
DB_NAME=careerai
DB_USERNAME=root
DB_PASSWORD=your_database_password_here
DB_URL=jdbc:mysql://localhost:3306/careerai?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# JWT Security Key & Expiration (24 hours in milliseconds)
JWT_SECRET=your_base64_or_hex_encoded_secret_key_min_256_bits
JWT_EXPIRATION=86400000

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:4200
